# =============================================================================
# Nexternel - Environment Configuration (package version: see VERSION at repo root)
# Copy this file to .env and fill in your values before starting the stack.
#
# If a value contains $ # spaces or ! wrap it in double quotes, e.g.:
#   MQTT_PASSWORD="p@ss w0rd$!"
# =============================================================================

# --- Server ---
# Your Ubuntu machine's LAN address — used for device configuration and System links (not the Docker IP).
SERVER_IP=YOUR_SERVER_IP

# --- PostgreSQL ---
POSTGRES_USER=nexternel
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=nexternel
DATABASE_URL=postgresql://nexternel:change_me_postgres_password@postgres:5432/nexternel

# --- InfluxDB 2.x ---
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change_me_influx_password
INFLUXDB_ORG=nexternel
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=change_me_influx_token_min_32_chars_long
INFLUXDB_URL=http://influxdb:8086

# --- MQTT (Mosquitto) ---
MQTT_BROKER=mqtt://mosquitto:1883
MQTT_USERNAME=nexternel
MQTT_PASSWORD=change_me_mqtt_password
MQTT_TOPIC_PREFIX=nexternel

# --- Auth (API JWT; NEXTAUTH_SECRET name kept for compatibility) ---
NEXTAUTH_SECRET=change_me_random_secret_at_least_32_characters
# COOKIE_SECURE=false
UI_PORT=8080
API_PORT=4000

# --- Cameras / go2rtc (CCTV live stream) ---
# Internal URL used by the API container to register RTSP streams.
GO2RTC_URL=http://go2rtc:1984
# Browser-facing go2rtc (optional). Leave blank — UI proxies /go2rtc on port 8080.
# GO2RTC_PUBLIC_URL=http://YOUR_SERVER_IP:1984
GO2RTC_PORT=1984

# --- Default admin (created by API on first start if missing) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# --- Timezone ---
TZ=Europe/London
